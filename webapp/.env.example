# Copy to .env and adjust as needed. Every value here is a default the app already
# applies, so an empty .env is a valid configuration.

# Source chroma DB for export_index.py. Defaults to <main checkout>/chroma_db, which
# is resolved via `git rev-parse --git-common-dir` so it works from a git worktree.
#WEBAPP_CHROMA_DB=/home/johannes/music-encoding/chroma_db

# Where the exported artifacts live (catalog.sqlite, vectors.npz, audio.sqlite).
#WEBAPP_DATA_DIR=/home/johannes/music-encoding/webapp/data

# MTG TSVs, used by the exporter for full-track durations.
#MTG_DATA_DIR=/home/johannes/mtg-jamendo-dataset/data

# Directory of MTG's raw_30s_audio-low-NN.tar archives (one per track_num % 100 bucket).
# fetch_mtg_audio.py writes here and local_audio_index.py reads here. Optional: without
# it only preview-backed tracks are playable.
#MTG_AUDIO_DIR=/home/johannes/mtg

# Proxy target for the SvelteKit dev server (ui/vite.config.ts).
#WEBAPP_API=http://127.0.0.1:8000

# Extra CORS origins for the API, comma-separated. The dev proxy makes this
# unnecessary; it exists for calling the API directly from another origin.
#WEBAPP_EXTRA_ORIGINS=
